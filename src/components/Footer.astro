---
import { Icon } from 'astro-icon/components';

interface Props {
  credits?: boolean;
}

const { credits = false } = Astro.props;
const today = new Date();
---

<footer>
  <div class="container bare">
    <div class="credits">
      <span>&copy; {today.getFullYear()} Hafid Nur. All rights reserved.</span>
      {credits && <small
        >Emoji animation by <a
          href="https://googlefonts.github.io/noto-emoji-animation/"
          target="_blank"
          rel="noopener noreferrer">Google Noto</a
        >, CC BY 4.0</small
      >}
    </div>
    <div class="social-links">
      <a
        href="https://www.linkedin.com/in/hafidnrzs/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sr-only">Follow Hafid Nur di LinkedIn</span>
        <Icon name="mdi:linkedin" />
      </a>
      <a
        href="https://github.com/hafidnrzs"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sr-only">Follow Hafid Nur di GitHub</span>
        <Icon name="mdi:github" />
      </a>
      <a
        href="https://www.facebook.com/hafidnrzs"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sr-only">Follow Hafid Nur di Facebook</span>
        <Icon name="mdi:facebook" />
      </a>
    </div>
  </div>
</footer>
<style>
  footer {
    background: var(--color-black);
    color: var(--color-white);
    font-size: var(--text-sm);
    text-align: center;
    :focus-visible {
      outline-color: var(--color-white);
    }
  }
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
  }
  .credits {
    display: grid;
    gap: 0.25rem;
    small {
      color: var(--color-line);
      font-size: var(--text-xs);
    }
  }
  .social-links {
    display: flex;
    gap: 1.2rem;
    a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background-color: var(--color-white);
      color: var(--color-black);
      text-decoration: none;
      &:hover {
        background-color: var(--color-line);
      }
    }
  }
  [data-icon] {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }
  @media (width >= 48rem) {
    .container {
      flex-direction: row;
    }
    .credits {
      justify-items: start;
      text-align: left;
    }
  }
</style>
