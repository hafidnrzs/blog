---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
---

<li>
  <a href={`/blog/${post.id}/`}>
    <FormattedDate date={pubDate} />
    <h2>{title}</h2>
    <p>{description}</p>
  </a>
</li>

<style>
  li {
    position: relative;
    padding: 1.25rem 0.75rem;
    border-top: 1px solid var(--color-rail);
  }
  /* Pale lime sweeps in from the left to mark the row under the pointer. */
  li::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-lime-pale);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease-out;
  }
  li:is(:hover, :has(a:focus-visible))::before {
    transform: scaleX(1);
  }
  a {
    position: relative;
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.35;
  }
  a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  p {
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  a :global(time) {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    li::before {
      transition: none;
    }
  }
  @media (width >= 48rem) {
    a {
      grid-template-columns: 9rem 1fr;
      column-gap: 1.5rem;
      :global(time) {
        grid-row: span 2;
        padding-top: 0.2rem;
      }
    }
  }
</style>
