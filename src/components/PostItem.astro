---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
---

<li>
  <a href={`/blog/${post.id}/`}>
    <FormattedDate date={pubDate} />
    <h2>{title}</h2>
    <p>{description}</p>
  </a>
</li>

<style>
  /* Histogram fill: eight columns that rise and fall in order, left to right. */
  /* The --b0..--b7 @property rules live in global.css. */
  li {
    position: relative;
  }
  /* Rules sit above the fill so the hover layer can never repaint them. */
  li::after {
    content: '';
    position: absolute;
    inset: 0;
    border-top: 1px solid var(--color-rail);
    pointer-events: none;
  }
  li:last-child::after {
    border-bottom: 1px solid var(--color-rail);
  }
  li::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 0.00% 100% / 12.6% var(--b0) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 14.29% 100% / 12.6% var(--b1) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 28.57% 100% / 12.6% var(--b2) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 42.86% 100% / 12.6% var(--b3) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 57.14% 100% / 12.6% var(--b4) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 71.43% 100% / 12.6% var(--b5) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 85.71% 100% / 12.6% var(--b6) no-repeat,
      linear-gradient(var(--color-lime-pale), var(--color-lime-pale)) 100.00% 100% / 12.6% var(--b7) no-repeat;
    /* Leaving: columns fall in order, 1 first, then 2, 3, 4... */
    transition:
      --b0 0.3s ease-in-out 0.00s,
      --b1 0.3s ease-in-out 0.04s,
      --b2 0.3s ease-in-out 0.08s,
      --b3 0.3s ease-in-out 0.12s,
      --b4 0.3s ease-in-out 0.16s,
      --b5 0.3s ease-in-out 0.20s,
      --b6 0.3s ease-in-out 0.24s,
      --b7 0.3s ease-in-out 0.28s;
  }
  li:is(:hover, :has(a:focus-visible))::before {
    --b0: 100%;
    --b1: 100%;
    --b2: 100%;
    --b3: 100%;
    --b4: 100%;
    --b5: 100%;
    --b6: 100%;
    --b7: 100%;
    transition:
      --b0 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.00s,
      --b1 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.04s,
      --b2 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.08s,
      --b3 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.12s,
      --b4 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.16s,
      --b5 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.20s,
      --b6 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.24s,
      --b7 0.3s cubic-bezier(0.2, 0.9, 0.25, 1) 0.28s;
  }
  a {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.35;
  }
  a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  p {
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  a :global(time) {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    li::before,
    li:is(:hover, :has(a:focus-visible))::before {
      transition: none;
    }
  }
  @media (width >= 48rem) {
    a {
      grid-template-columns: 9rem 1fr;
      column-gap: 1.5rem;
      :global(time) {
        grid-row: span 2;
        padding-top: 0.2rem;
      }
    }
  }
</style>
