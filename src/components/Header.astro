---
import HeaderLink from './HeaderLink.astro';
---

<header class="band">
  <nav class="container bare navbar">
    <h2 class="site-title"><a href="/" class="logo">Hafid Nur</a></h2>
    <div class="internal-links">
      <HeaderLink href="/blog">Blog</HeaderLink>
    </div>
  </nav>
</header>
<style>
  header {
    height: var(--header-h);
    background-color: var(--color-lime);
  }
  .navbar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-title {
    font-size: var(--text-xl);
    line-height: 1;
  }
  .logo,
  .internal-links :global(a) {
    color: var(--color-black);
    text-decoration: none;
  }
  .internal-links :global(a) {
    position: relative;
    padding-block: 0.125rem;
    font-size: var(--text-base);
    color: var(--color-muted);
    /* Keeps the tap target tall while the underline hugs the text. */
    &::after {
      content: '';
      position: absolute;
      inset: -0.75rem -0.5rem;
    }
    &:hover {
      color: var(--color-black);
    }
    &.active {
      color: var(--color-black);
    }
  }
</style>
