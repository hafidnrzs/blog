---
// Giscus comments. Threads map to the URL pathname, so keep slugs stable.
---

<section class="comments">
  <hr />
  <h2>Komentar</h2>
  <script
    src="https://giscus.app/client.js"
    data-repo="hafidnrzs/blog"
    data-repo-id="R_kgDOOOOdaQ"
    data-category="General"
    data-category-id="DIC_kwDOOOOdac4C23fw"
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="light"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>

<style>
  .comments {
    margin-top: 3rem;
  }
  .comments hr {
    border: none;
    border-top: 1px solid var(--color-gray-02);
    margin-bottom: 1.25rem;
  }
</style>
